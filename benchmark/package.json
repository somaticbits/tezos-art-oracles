{
  "name": "oracle-benchmark",
  "version": "2.0.0",
  "private": true,
  "description": "Measures what it costs to store sensor readings in three Tezos oracle contract designs (map, big_map, record big_map).",
  "license": "MIT",
  "author": "David Pettersson (https://somaticbits.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/somaticbits/tezos-art-oracles.git",
    "directory": "benchmark"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "deploy": "tsx src/deploy.ts",
    "sandbox": "../contracts/run_sandbox.sh",
    "compile-contracts": "../contracts/compile_all.sh",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@taquito/rpc": "^25.0.0",
    "@taquito/signer": "^25.0.0",
    "@taquito/taquito": "^25.0.0",
    "csv-stringify": "^6.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
